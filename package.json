{
  "name": "zmalacall-project",
  "private": true,
  "scripts": {
    "build:admin": "node build_tools/build-admin.cjs",
    "build:check": "node build_tools/build-admin.cjs --check",
    "typecheck": "tsc -p zmala_server/tsconfig.json && tsc -p zmala_server/tsconfig.admin.json",
    "pretest": "node build_tools/build-admin.cjs",
    "start": "npm --prefix zmala_server start",
    "test": "npm --prefix zmala_server test",
    "format": "prettier --write \"zmala_server/**/*.{js,cjs,ts,css,html}\" \"tests/**/*.{js,cjs}\" \"build_tools/*.{js,cjs}\" \"zmala_server/tsconfig*.json\" && npm run build:admin",
    "format:check": "prettier --check \"zmala_server/**/*.{js,cjs,ts,css,html}\" \"tests/**/*.{js,cjs}\" \"build_tools/*.{js,cjs}\" \"zmala_server/tsconfig*.json\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
