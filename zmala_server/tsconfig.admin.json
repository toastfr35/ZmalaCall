{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "sip": ["./types/sip.d.ts"],
      "sip/proxy": ["./types/sip-proxy.d.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["types/**/*.ts", "web/admin-*.js"],
  "exclude": ["node_modules", "vendor", "data", "tests", "web/admin.js"]
}
