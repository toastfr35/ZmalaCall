[Unit]
Description=Recover confirmed ZmalaCall application before startup
Before=zmalacall-terminal.service

[Service]
# @llr LLR-TERM-MAINT-030
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/usr/local/lib/zmalacall-updater/current
ExecStart=/usr/bin/python3 -m zmala_terminal.linux.update_service recover
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=zmalacall-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=120
