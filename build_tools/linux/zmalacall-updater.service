[Unit]
Description=Automatic ZmalaCall application updates
Wants=network-online.target
After=network-online.target zmalacall-terminal.service
StartLimitIntervalSec=0

[Service]
# @llr LLR-TERM-MAINT-030
Type=simple
WorkingDirectory=/usr/local/lib/zmalacall-updater/current
ExecStart=/usr/bin/python3 -m zmala_terminal.linux.update_service run
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=zmalacall-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=15
MemoryMax=384M
Nice=10
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
