{
  "schema": 1,
  "architecture": "arm64",
  "distribution": "trixie",
  "board": "pi4",
  "rauc_version": "1.13-3+deb13u1",
  "qualification": "development-only",
  "roles": {
    "terminal": {
      "application_data": "/var/lib/zmalacall",
      "application_service": "zmalacall-terminal.service",
      "packages_file": "build_tools/linux/dependencies.txt",
      "extra_packages": [
        "xserver-xorg-core",
        "xserver-xorg-input-libinput",
        "openbox",
        "picom",
        "xauth",
        "x11-utils",
        "x11-xserver-utils",
        "polkitd"
      ]
    },
    "server": {
      "application_data": "/var/lib/zmalacall-server",
      "application_service": "zmalacall-server.service",
      "extra_packages": [
        "nodejs",
        "python3",
        "python3-pil",
        "nftables",
        "avahi-daemon",
        "rpi-swap",
        "network-manager"
      ]
    },
    "combined": {
      "display_name": "Zmala Terminal + Server",
      "components": [
        "terminal",
        "server"
      ],
      "extra_packages": []
    }
  }
}
